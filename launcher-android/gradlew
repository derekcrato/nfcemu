#!/bin/sh
# Gradle wrapper script
DIST_URL="https://services.gradle.org/distributions/gradle-8.7-bin.zip"
INSTALL_DIR="$HOME/.gradle/wrapper/dists/gradle-8.7-bin"
ZIP_FILE="$INSTALL_DIR/gradle-8.7-bin.zip"

mkdir -p "$INSTALL_DIR"

if [ ! -d "$INSTALL_DIR/gradle-8.7" ]; then
    echo "Downloading Gradle 8.7..."
    curl -L -o "$ZIP_FILE" "$DIST_URL"
    unzip -q "$ZIP_FILE" -d "$INSTALL_DIR"
fi

exec "$INSTALL_DIR/gradle-8.7/bin/gradle" "$@"
